{
  "name": "slotbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/start.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/start.js",
    "db:setup": "tsx server/setup.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/slots.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "luxon": "^3.7.2",
    "zod": "^4.1.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/pg": "^8.15.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vite": "^7.1.12"
  }
}
